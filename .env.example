# ── LLM Configuration ───────────────────────────────────────────────────────
# Option 1: Groq (recommended for cloud/Vercel – free tier at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Option 2: Ollama (local development only – https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Flask Configuration ──────────────────────────────────────────────────────
# Required on Vercel to keep sessions valid across invocations
SECRET_KEY=change-this-to-a-random-secret-string
